@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Pradžia</PageTitle>

<div class="home-hero">
    <h1>Sveiki atvykę į karo muziejų</h1>
    <p class="subtitle">Atraskite mūsų eksponatus ir istoriją</p>
    <div class="button-group">
        <button class="btn-hero" @onclick="OpenExhibitManagement">
            Valdyti eksponatus
        </button>
        <button class="btn-hero" @onclick="OpenExhibitPlaceHoldersManagement">
            Valdyti eksponavimo vietas
        </button>
        <button class="btn-hero" @onclick="OpenHolidayManagementPage">
            Valdyti atostogų užklausas
        </button>
        <button class="btn-hero btn-secondary" @onclick="OpenHolidayPage">
            Peržiūrėti atostogas
        </button>
        <button class="btn-hero" @onclick="OpenScheduleManagementPage">
            Peržiūrėti tvarkaraščius
        </button>
        <button class="btn-hero btn-secondary" @onclick="OpenTours">
            Peržiūrėti ekskursijas
        </button>
    </div>
</div>

@code {
    private void OpenExhibitManagement()
    {
        Nav.NavigateTo("/exhibit-management");
    }

    private void OpenExhibitPlaceHoldersManagement()
    {
        Nav.NavigateTo("/exhibit-place-holders-management");
    }
    
    private void OpenTours()
    {
        Nav.NavigateTo("/tours");
    }
    
        private void OpenScheduleManagementPage()
        {
            Nav.NavigateTo("/schedule-management");
        }

    private void OpenHolidayPage()
    {
        Nav.NavigateTo("/holidays");
    }

    private void OpenHolidayManagementPage()
    {
        Nav.NavigateTo("/holiday-management");
    }
}